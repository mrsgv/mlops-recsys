# Client-side configuration. Copy to .env and adjust; never commit .env.
#
# The tracking URI is the only thing that decides where experiments are recorded,
# and it is read from the environment — never hardcoded — so you can move between
# a local store and Cloud Run without touching any code.

# Cloud Run tracking server, reached through the authenticated proxy:
#   gcloud run services proxy mlflow --region=asia-south1 --port=8080
MLFLOW_TRACKING_URI=http://localhost:8080

# Offline alternative, no cloud and no auth:
# MLFLOW_TRACKING_URI=file:./mlruns
