# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual envs
.venv/
venv/
env/

# Data & models (tracked via DVC, not git)
data/raw/*
data/processed/*
models/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# DVC pointer files
!data/raw/*.dvc
!data/processed/*.dvc
!models/*.dvc

# MLflow / experiment artifacts
mlruns/
mlflow.db

# Airflow local runtime
airflow/logs/
airflow/*.db
airflow/*.cfg

# OS / IDE
.DS_Store
.idea/
.vscode/

# Environment / secrets
.env
.env.*
!.env.example

# Google / OAuth credentials
client_secret_*.json
credentials*.json
token*.json